# WorkMap pilot local/deployment minimum configuration.
#
# Recommended local ports:
# - web: http://localhost:3000
# - api: http://localhost:3001

# Database used by Prisma migrations, seed, and API runtime.
DATABASE_URL="postgresql://workmap:workmap@localhost:5432/workmap?schema=public"

# Optional local cache URL. Keep aligned with deployment if Redis-backed features are enabled.
REDIS_URL="redis://localhost:6379"

# Public web URL and browser-visible API URL.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_WORKMAP_API_URL="http://localhost:3001"

# API runtime port.
API_PORT="3001"

# Required for backend-issued JWTs. Use a long unique secret outside local demos.
WORKMAP_JWT_SECRET="replace-with-a-local-development-secret-at-least-32-chars"

# Required for pilot login outside development. The example hash matches the local seeded pilot password.
WORKMAP_PILOT_PASSWORD_HASH="pbkdf2-sha256$120000$workmap-local-pilot$ogb3euHMstmx-Dp4fkSgKaZ_iaq4tnKPHWpLO5TpS_k"
