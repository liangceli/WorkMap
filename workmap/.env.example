# WorkMap STAGE 2 local/deployment baseline.
#
# Recommended local ports:
# - web: http://localhost:3000
# - api: http://localhost:3001
#
# Do not commit real production secrets. Put real values directly into Vercel,
# Render, Supabase, and AWS consoles where possible.

# ---------------------------------------------------------------------------
# Frontend public env: Vercel / Next.js
# ---------------------------------------------------------------------------

# Public web URL. Local default is http://localhost:3000.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Browser-visible API URL. Vercel should point this at the Render API URL.
NEXT_PUBLIC_WORKMAP_API_URL="http://localhost:3001"

# Cognito Hosted UI / Amplify-compatible public config.
# Leave blank locally until an AWS Cognito user pool and app client exist.
NEXT_PUBLIC_COGNITO_REGION=""
NEXT_PUBLIC_COGNITO_USER_POOL_ID=""
NEXT_PUBLIC_COGNITO_APP_CLIENT_ID=""
NEXT_PUBLIC_COGNITO_DOMAIN=""
NEXT_PUBLIC_COGNITO_REDIRECT_URI="http://localhost:3000/login/callback"
NEXT_PUBLIC_COGNITO_LOGOUT_URI="http://localhost:3000/login"
NEXT_PUBLIC_COGNITO_SCOPE="openid email profile"

# Optional local development identity override for dev-token fallback only.
NEXT_PUBLIC_WORKMAP_DEV_AUTH_EMAIL=""
NEXT_PUBLIC_WORKMAP_DEV_AUTH_COMPANY_SLUG=""

# ---------------------------------------------------------------------------
# Backend/server env: Render / API
# ---------------------------------------------------------------------------

# Supabase Postgres or local Postgres URL used by Prisma and API runtime.
DATABASE_URL="postgresql://workmap:workmap@localhost:5432/workmap?schema=public"

# Optional local cache URL. Keep aligned with deployment only if Redis-backed
# features are enabled.
REDIS_URL="redis://localhost:6379"

# Render usually provides PORT; WorkMap also supports API_PORT for local use.
API_PORT="3001"

# Frontend app URL used by backend-generated invite links.
WORKMAP_APP_URL="http://localhost:3000"

# CORS origin allowlist for deployed web apps. Comma-separated.
# Production should set this to the exact Vercel origin(s), not "*".
WORKMAP_ALLOWED_ORIGINS="http://localhost:3000"

# Backward-compatible single-origin fallback. Prefer WORKMAP_ALLOWED_ORIGINS.
WORKMAP_ALLOWED_ORIGIN="http://localhost:3000"

# Required for existing backend-issued pilot/dev JWTs during the transition.
# Use a long unique secret outside local demos.
WORKMAP_JWT_SECRET="replace-with-a-local-development-secret-at-least-32-chars"

# Required for pilot login outside development. The example hash matches the
# local seeded pilot password. Do not reuse it as a real production password.
WORKMAP_PILOT_PASSWORD_HASH="pbkdf2-sha256$120000$workmap-local-pilot$ogb3euHMstmx-Dp4fkSgKaZ_iaq4tnKPHWpLO5TpS_k"

# Cognito backend JWT verification config.
# WORKMAP_COGNITO_ISSUER may be set directly, or derived from region/user pool.
WORKMAP_COGNITO_ISSUER=""
WORKMAP_COGNITO_REGION=""
WORKMAP_COGNITO_USER_POOL_ID=""
WORKMAP_COGNITO_APP_CLIENT_ID=""

# Temporary STAGE 2 mapping scope for Cognito email -> WorkMap user.
# If blank and the same email exists in multiple companies, the API rejects
# Cognito auth until this is configured or a Cognito sub mapping is added.
WORKMAP_COGNITO_COMPANY_SLUG=""

# Platform admin bootstrap allowlist. Keep tenant OWNER separate from platform
# admin: only identities listed here receive platformRole=PLATFORM_ADMIN.
# Use comma-separated verified emails and/or Cognito sub values. Do not commit
# real production administrator identities in this example file.
WORKMAP_PLATFORM_ADMIN_EMAILS=""
WORKMAP_PLATFORM_ADMIN_COGNITO_SUBS=""

# ---------------------------------------------------------------------------
# Local activity tracking harnesses
# ---------------------------------------------------------------------------

# Desktop-agent harness configuration. Use a real authenticated WorkMap bearer
# token only in local env or platform secret storage; never commit it.
WORKMAP_API_BASE_URL=""
WORKMAP_AGENT_TOKEN=""
WORKMAP_AGENT_DEVICE_ID=""
WORKMAP_AGENT_HOSTNAME=""
WORKMAP_AGENT_OS=""
WORKMAP_AGENT_VERSION=""
WORKMAP_AGENT_SAMPLE_APP=""
WORKMAP_AGENT_SAMPLE_DURATION_MS=""

# Browser extension harness configuration is stored in chrome.storage.local:
# - workmapApiBaseUrl
# - workmapAuthToken
# - workmapDeviceId
# - workmapBrowserName
