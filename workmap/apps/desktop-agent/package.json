{
  "name": "@workmap/desktop-agent",
  "version": "0.5.10",
  "description": "Privacy-minimized foreground application usage agent for WorkMap employees.",
  "author": "WorkMap",
  "private": true,
  "type": "module",
  "main": "dist/electron/main.js",
  "scripts": {
    "dev": "tsc --watch --noEmit",
    "build": "tsc && node scripts/build-alpha.mjs",
    "dev:gui": "tsc && electron .",
    "release:windows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/generate-app-icon.ps1 && tsc && electron-builder --win nsis --x64",
    "lint": "eslint .",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12",
    "eslint": "^9.17.0"
  },
  "build": {
    "appId": "app.workmap.desktop-agent",
    "productName": "WorkMap Desktop Agent",
    "asar": true,
    "directories": {
      "output": "../../artifacts/desktop-agent"
    },
    "files": [
      "dist/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "scripts/windows-foreground.ps1",
        "to": "agent-scripts/windows-foreground.ps1"
      },
      {
        "from": "scripts/credential-protection.ps1",
        "to": "agent-scripts/credential-protection.ps1"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "artifactName": "WorkMap-Desktop-Agent-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "WorkMap Desktop Agent"
    }
  }
}
