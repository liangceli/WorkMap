{
  "manifest_version": 3,
  "name": "CandidGrid Domain Tracking",
  "version": "0.5.18",
  "description": "Policy-controlled hostname Focus and optional Domain open/runtime collection. Does not record URL paths, queries, fragments, titles or page content.",
  "permissions": ["storage", "tabs", "idle", "alarms", "scripting"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "incognito": "not_allowed",
  "icons": {
    "16": "icons/candidgrid-16.png",
    "32": "icons/candidgrid-32.png",
    "48": "icons/candidgrid-48.png",
    "128": "icons/candidgrid-128.png"
  },
  "background": {
    "service_worker": "dist/backgroundV2.js",
    "type": "module"
  },
  "options_page": "options.html"
}
