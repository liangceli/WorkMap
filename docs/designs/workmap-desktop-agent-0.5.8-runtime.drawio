<mxfile host="app.diagrams.net" modified="2026-07-16T05:30:00.000Z" agent="Codex" version="26.0.11" type="device">
  <diagram id="desktop-agent-runtime-058" name="0.5.8 运行链路">
    <mxGraphModel dx="1800" dy="1080" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="WorkMap Desktop Agent 0.5.8 | Windows 运行与数据链路" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontStyle=1;fontSize=28;fontColor=#0B1635;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1160" height="42" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="基于仓库当前实现：Electron 入口 + Windows 原生采样 + 可恢复状态机 + 本地持久队列 + 受限设备 API" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontColor=#52607A;" vertex="1" parent="1"><mxGeometry x="42" y="62" width="1280" height="24" as="geometry"/></mxCell>

        <mxCell id="lane-start" value="1. 启动与安全配对" style="swimlane;html=1;horizontal=1;startSize=34;rounded=1;fillColor=#F4F7FB;swimlaneFillColor=#0B1635;strokeColor=#CCD5E2;fontColor=#FFFFFF;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="1740" height="260" as="geometry"/></mxCell>
        <mxCell id="electron" value="Electron 启动&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;单实例锁；系统托盘；已打包时开机后台启动&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#24365A;fontColor=#0B1635;fontStyle=1;fontSize=15;" vertex="1" parent="lane-start"><mxGeometry x="30" y="76" width="200" height="82" as="geometry"/></mxCell>
        <mxCell id="config" value="读取本地配置&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;%LOCALAPPDATA%\WorkMap\DesktopAgent\config.json&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#24365A;fontColor=#0B1635;fontStyle=1;fontSize=15;" vertex="1" parent="lane-start"><mxGeometry x="270" y="76" width="235" height="82" as="geometry"/></mxCell>
        <mxCell id="paired" value="已配对？" style="rhombus;html=1;whiteSpace=wrap;fillColor=#FFF4D9;strokeColor=#F3A61B;fontColor=#563500;fontStyle=1;fontSize=15;" vertex="1" parent="lane-start"><mxGeometry x="550" y="73" width="115" height="88" as="geometry"/></mxCell>
        <mxCell id="pairui" value="未配对 UI&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;用户输入 8 位一次性 pairing code&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFF8EA;strokeColor=#F3A61B;fontColor=#563500;fontStyle=1;fontSize=15;" vertex="1" parent="lane-start"><mxGeometry x="725" y="145" width="220" height="74" as="geometry"/></mxCell>
        <mxCell id="pairapi" value="配对请求&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;GET /health → POST /device-client/pair&lt;br&gt;只允许 HTTPS（本地开发例外）&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#EDF8F5;strokeColor=#14A87C;fontColor=#073A2C;fontStyle=1;fontSize=14;" vertex="1" parent="lane-start"><mxGeometry x="1000" y="145" width="260" height="74" as="geometry"/></mxCell>
        <mxCell id="dpapi" value="Windows DPAPI 保存凭据&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;服务端只给本设备受限 credential；磁盘只保存 protectedCredential&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#EDF8F5;strokeColor=#14A87C;fontColor=#073A2C;fontStyle=1;fontSize=14;" vertex="1" parent="lane-start"><mxGeometry x="1310" y="145" width="310" height="74" as="geometry"/></mxCell>
        <mxCell id="runtime-start" value="启动 DesktopAgentRuntime&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;同一 deviceId 的旧队列可继续使用&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#DBF5EC;strokeColor=#14A87C;fontColor=#073A2C;fontStyle=1;fontSize=14;" vertex="1" parent="lane-start"><mxGeometry x="1425" y="76" width="270" height="82" as="geometry"/></mxCell>

        <mxCell id="lane-track" value="2. Windows 原生采样与时间状态机" style="swimlane;html=1;horizontal=1;startSize=34;rounded=1;fillColor=#F8FAFD;swimlaneFillColor=#123B5D;strokeColor=#CCD5E2;fontColor=#FFFFFF;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="1740" height="290" as="geometry"/></mxCell>
        <mxCell id="adapter" value="WindowsForegroundAdapter&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;每 100ms 请求常驻 PowerShell sampler&lt;br&gt;每 1 秒枚举可见窗口的应用&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#EAF2FB;strokeColor=#2463A8;fontColor=#0A315B;fontStyle=1;fontSize=15;" vertex="1" parent="lane-track"><mxGeometry x="30" y="90" width="270" height="106" as="geometry"/></mxCell>
        <mxCell id="native" value="Windows API（C# P/Invoke）&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;GetForegroundWindow · EnumWindows&lt;br&gt;GetLastInputInfo · OpenInputDesktop&lt;br&gt;UWP ApplicationFrameHost 子窗口解析&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#2463A8;fontColor=#0A315B;fontStyle=1;fontSize=14;" vertex="1" parent="lane-track"><mxGeometry x="345" y="90" width="330" height="106" as="geometry"/></mxCell>
        <mxCell id="sample" value="ForegroundSample&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;规范化 appName；openAppNames；idle / locked；最后输入时间&lt;br&gt;不读取窗口标题、文档名、屏幕、键盘内容或剪贴板&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#2463A8;fontColor=#0A315B;fontStyle=1;fontSize=14;" vertex="1" parent="lane-track"><mxGeometry x="720" y="90" width="355" height="106" as="geometry"/></mxCell>
        <mxCell id="state" value="AppTrackingState&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;按 app 维护 Focus segments、Idle segment、Open runtime segments&lt;br&gt;乱序/重复采样丢弃；最大采样缺口 15 秒；UTC 跨日切片&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#E8F7F2;strokeColor=#14A87C;fontColor=#073A2C;fontStyle=1;fontSize=15;" vertex="1" parent="lane-track"><mxGeometry x="1120" y="80" width="360" height="126" as="geometry"/></mxCell>
        <mxCell id="events" value="完成的 AppUsageEvent&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Focus Active：新输入后最多 30 秒 grace&lt;br&gt;Focused Idle：达到 30 秒系统空闲&lt;br&gt;Open Runtime：可见窗口存在的 10 秒片段&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFF8EA;strokeColor=#F3A61B;fontColor=#563500;fontStyle=1;fontSize=14;" vertex="1" parent="lane-track"><mxGeometry x="1525" y="80" width="185" height="126" as="geometry"/></mxCell>
        <mxCell id="track-note" value="Active Time 只由真实输入触发；窗口仅“打开”不会成为 Focus Active。锁屏、没有有效前台窗口、空闲都会关闭或转换当前 Focus 片段。" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#F3F7F5;strokeColor=#B9D2C8;fontColor=#275040;fontSize=14;" vertex="1" parent="lane-track"><mxGeometry x="345" y="225" width="1135" height="38" as="geometry"/></mxCell>

        <mxCell id="lane-sync" value="3. 持久化、同步与 Reports 可见性" style="swimlane;html=1;horizontal=1;startSize=34;rounded=1;fillColor=#F7F9FC;swimlaneFillColor=#0B1635;strokeColor=#CCD5E2;fontColor=#FFFFFF;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="720" width="1740" height="290" as="geometry"/></mxCell>
        <mxCell id="startup-recovery" value="启动恢复&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;读取 queue / status-queue / tracking checkpoint&lt;br&gt;将未完成 Focus checkpoint 转为待上传事件&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#F5F0FC;strokeColor=#7357B8;fontColor=#382166;fontStyle=1;fontSize=14;" vertex="1" parent="lane-sync"><mxGeometry x="30" y="80" width="280" height="100" as="geometry"/></mxCell>
        <mxCell id="local-files" value="%LOCALAPPDATA%\WorkMap\DesktopAgent&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;queue.json · status-queue.json · tracking-state.json · status.json&lt;br&gt;每队列上限 1,000；事件最长保留 31 天；原子写入&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#F5F0FC;strokeColor=#7357B8;fontColor=#382166;fontStyle=1;fontSize=14;" vertex="1" parent="lane-sync"><mxGeometry x="365" y="80" width="355" height="100" as="geometry"/></mxCell>
        <mxCell id="session-heartbeat" value="会话与 Heartbeat&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;POST /session/start&lt;br&gt;POST /heartbeat：首次、每 10 秒或片段完成时&lt;br&gt;携带当前活动、sequence、时区&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#EAF2FB;strokeColor=#2463A8;fontColor=#0A315B;fontStyle=1;fontSize=14;" vertex="1" parent="lane-sync"><mxGeometry x="765" y="80" width="285" height="100" as="geometry"/></mxCell>
        <mxCell id="upload" value="批量上传与幂等&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;POST /app-usage（最多 50）&lt;br&gt;POST /status-event&lt;br&gt;clientEventId + sequence + monotonic time&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#E8F7F2;strokeColor=#14A87C;fontColor=#073A2C;fontStyle=1;fontSize=14;" vertex="1" parent="lane-sync"><mxGeometry x="1095" y="80" width="260" height="100" as="geometry"/></mxCell>
        <mxCell id="backend" value="受限 Device API&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;验证 credential 与 tenant / user / device 绑定&lt;br&gt;入库 ActivityEvent、AgentSession、DeviceStatusEvent&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#0B1635;fontColor=#0B1635;fontStyle=1;fontSize=14;" vertex="1" parent="lane-sync"><mxGeometry x="1400" y="80" width="280" height="100" as="geometry"/></mxCell>
        <mxCell id="retry" value="失败处理：网络或 5xx 进入持久队列，5s 指数退避，最长 5 分钟；4xx 丢弃无效 payload；401/403 → auth_required，停止无意义重试。" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFF4F2;strokeColor=#D24A43;fontColor=#7D1713;fontSize=14;" vertex="1" parent="lane-sync"><mxGeometry x="365" y="215" width="990" height="38" as="geometry"/></mxCell>
        <mxCell id="reports" value="Owner / Employee Reports&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;App 汇总、当前状态、会话与状态审计&lt;br&gt;由后端按 role 与 tenant 过滤&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFF8EA;strokeColor=#F3A61B;fontColor=#563500;fontStyle=1;fontSize=14;" vertex="1" parent="lane-sync"><mxGeometry x="1400" y="205" width="280" height="54" as="geometry"/></mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#24365A;" edge="1" parent="1" source="electron" target="config"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#24365A;" edge="1" parent="1" source="config" target="paired"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#F3A61B;fontColor=#563500;labelBackgroundColor=#FFF8EA;" edge="1" parent="1" source="paired" target="pairui"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#F3A61B;" edge="1" parent="1" source="pairui" target="pairapi"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#14A87C;" edge="1" parent="1" source="pairapi" target="dpapi"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#14A87C;" edge="1" parent="1" source="dpapi" target="runtime-start"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#14A87C;fontColor=#073A2C;labelBackgroundColor=#EDF8F5;" edge="1" parent="1" source="paired" target="runtime-start"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="705" y="230"/><mxPoint x="1490" y="230"/></Array></mxGeometry></mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#2463A8;" edge="1" parent="1" source="adapter" target="native"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#2463A8;" edge="1" parent="1" source="native" target="sample"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#14A87C;" edge="1" parent="1" source="sample" target="state"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#F3A61B;" edge="1" parent="1" source="state" target="events"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#7357B8;" edge="1" parent="1" source="startup-recovery" target="local-files"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#2463A8;" edge="1" parent="1" source="local-files" target="session-heartbeat"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#14A87C;" edge="1" parent="1" source="session-heartbeat" target="upload"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e15" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#0B1635;" edge="1" parent="1" source="upload" target="backend"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e16" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#F3A61B;" edge="1" parent="1" source="backend" target="reports"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e17" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#7357B8;dashed=1;" edge="1" parent="1" source="events" target="local-files"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1680" y="710"/><mxPoint x="600" y="710"/></Array></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="desktop-agent-state-058" name="状态、队列与退出">
    <mxGraphModel dx="1800" dy="1080" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title2" value="WorkMap Desktop Agent 0.5.8 | 状态、断网恢复与退出闭环" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontStyle=1;fontSize=28;fontColor=#0B1635;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="42" as="geometry"/></mxCell>
        <mxCell id="state-lane" value="设备运行状态" style="swimlane;html=1;horizontal=1;startSize=34;rounded=1;fillColor=#F7F9FC;swimlaneFillColor=#0B1635;strokeColor=#CCD5E2;fontColor=#FFFFFF;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="1010" height="790" as="geometry"/></mxCell>
        <mxCell id="unpaired" value="Unpaired" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#F2F4F8;strokeColor=#6B778E;fontColor=#273449;fontStyle=1;fontSize=16;" vertex="1" parent="state-lane"><mxGeometry x="45" y="90" width="160" height="62" as="geometry"/></mxCell>
        <mxCell id="pairing2" value="Pairing" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFF8EA;strokeColor=#F3A61B;fontColor=#563500;fontStyle=1;fontSize=16;" vertex="1" parent="state-lane"><mxGeometry x="270" y="90" width="160" height="62" as="geometry"/></mxCell>
        <mxCell id="running" value="Running / Connected&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;会话有效，heartbeat 成功&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#DBF5EC;strokeColor=#14A87C;fontColor=#073A2C;fontStyle=1;fontSize=16;" vertex="1" parent="state-lane"><mxGeometry x="495" y="80" width="220" height="82" as="geometry"/></mxCell>
        <mxCell id="userstop" value="Stopped by user&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;仅 Quit Agent / 明确停止&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#EAF2FB;strokeColor=#2463A8;fontColor=#0A315B;fontStyle=1;fontSize=15;" vertex="1" parent="state-lane"><mxGeometry x="780" y="80" width="185" height="82" as="geometry"/></mxCell>
        <mxCell id="network" value="Network Offline&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;网络请求失败&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFF4F2;strokeColor=#D24A43;fontColor=#7D1713;fontStyle=1;fontSize=15;" vertex="1" parent="state-lane"><mxGeometry x="160" y="260" width="185" height="80" as="geometry"/></mxCell>
        <mxCell id="server" value="Server Unreachable&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;API 5xx&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFF4F2;strokeColor=#D24A43;fontColor=#7D1713;fontStyle=1;fontSize=15;" vertex="1" parent="state-lane"><mxGeometry x="420" y="260" width="185" height="80" as="geometry"/></mxCell>
        <mxCell id="power" value="Locked / Sleeping&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Electron powerMonitor&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#F5F0FC;strokeColor=#7357B8;fontColor=#382166;fontStyle=1;fontSize=15;" vertex="1" parent="state-lane"><mxGeometry x="680" y="260" width="185" height="80" as="geometry"/></mxCell>
        <mxCell id="auth" value="Auth required&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;401 / 403：停止重试，需重新配对&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FCEDEF;strokeColor=#B21F35;fontColor=#70101D;fontStyle=1;fontSize=15;" vertex="1" parent="state-lane"><mxGeometry x="395" y="440" width="250" height="82" as="geometry"/></mxCell>
        <mxCell id="crash" value="异常结束 / 强制终止&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;客户端可能无法发最后状态；服务端按 heartbeat 过期推断中断&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FCEDEF;strokeColor=#B21F35;fontColor=#70101D;fontStyle=1;fontSize=15;" vertex="1" parent="state-lane"><mxGeometry x="80" y="580" width="300" height="88" as="geometry"/></mxCell>
        <mxCell id="restart" value="下次启动恢复&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;checkpoint → 完成片段；继续 queue/status-queue&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#EAF2FB;strokeColor=#2463A8;fontColor=#0A315B;fontStyle=1;fontSize=15;" vertex="1" parent="state-lane"><mxGeometry x="535" y="590" width="300" height="72" as="geometry"/></mxCell>
        <mxCell id="shutdown" value="Graceful shutdown&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;关闭片段、写 status event、尽力 flush、POST /session/stop&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#EDF8F5;strokeColor=#14A87C;fontColor=#073A2C;fontStyle=1;fontSize=15;" vertex="1" parent="state-lane"><mxGeometry x="660" y="440" width="285" height="82" as="geometry"/></mxCell>

        <mxCell id="queue-lane" value="本地队列的确认与重试" style="swimlane;html=1;horizontal=1;startSize=34;rounded=1;fillColor=#F8FAFD;swimlaneFillColor=#123B5D;strokeColor=#CCD5E2;fontColor=#FFFFFF;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1100" y="100" width="680" height="790" as="geometry"/></mxCell>
        <mxCell id="enqueue2" value="完成活动 / 状态变化&lt;br&gt;写入持久 JSON 队列" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#F5F0FC;strokeColor=#7357B8;fontColor=#382166;fontStyle=1;fontSize=15;" vertex="1" parent="queue-lane"><mxGeometry x="85" y="85" width="250" height="70" as="geometry"/></mxCell>
        <mxCell id="ready2" value="ready events&lt;br&gt;最多 50 条 / 批" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#2463A8;fontColor=#0A315B;fontStyle=1;fontSize=15;" vertex="1" parent="queue-lane"><mxGeometry x="370" y="85" width="190" height="70" as="geometry"/></mxCell>
        <mxCell id="post2" value="POST Device API" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#E8F7F2;strokeColor=#14A87C;fontColor=#073A2C;fontStyle=1;fontSize=15;" vertex="1" parent="queue-lane"><mxGeometry x="215" y="230" width="220" height="62" as="geometry"/></mxCell>
        <mxCell id="ack2" value="2xx → acknowledge&lt;br&gt;从队列删除；更新 last upload / status 时间" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#DBF5EC;strokeColor=#14A87C;fontColor=#073A2C;fontStyle=1;fontSize=14;" vertex="1" parent="queue-lane"><mxGeometry x="85" y="370" width="250" height="74" as="geometry"/></mxCell>
        <mxCell id="retry2" value="网络或 5xx → retry&lt;br&gt;5s × 2^attempt，最长 5 分钟&lt;br&gt;离线期间仍保留" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFF8EA;strokeColor=#F3A61B;fontColor=#563500;fontStyle=1;fontSize=14;" vertex="1" parent="queue-lane"><mxGeometry x="370" y="370" width="250" height="74" as="geometry"/></mxCell>
        <mxCell id="discard2" value="其他 4xx → discard&lt;br&gt;无效 payload 不反复重试" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FCEDEF;strokeColor=#B21F35;fontColor=#70101D;fontStyle=1;fontSize=14;" vertex="1" parent="queue-lane"><mxGeometry x="85" y="535" width="250" height="64" as="geometry"/></mxCell>
        <mxCell id="reconnect2" value="下一次 heartbeat 成功&lt;br&gt;Network / Server 状态恢复为 Connected&lt;br&gt;并补传已就绪队列" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#EAF2FB;strokeColor=#2463A8;fontColor=#0A315B;fontStyle=1;fontSize=14;" vertex="1" parent="queue-lane"><mxGeometry x="370" y="535" width="250" height="72" as="geometry"/></mxCell>
        <mxCell id="queue-note" value="队列容量：1,000；保存期：31 天。每个 activity/status event 有 clientEventId，重传由后端幂等处理。" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#F3F7F5;strokeColor=#B9D2C8;fontColor=#275040;fontSize=14;" vertex="1" parent="queue-lane"><mxGeometry x="60" y="665" width="540" height="54" as="geometry"/></mxCell>

