<mxfile host="app.diagrams.net" modified="2026-07-16T07:10:00.000Z" agent="Codex" version="26.0.11" type="device">
  <diagram id="desktop-agent-runtime-059" name="0.5.9 Runtime and Reports Flow">
    <mxGraphModel dx="1800" dy="1080" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="WorkMap Desktop Agent 0.5.9 | Durable focus reporting" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontStyle=1;fontSize=28;fontColor=#0B1635;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1460" height="42" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Windows foreground sampling, privacy-minimized activity slices, durable queues, and Reports visibility. No window title, document content, screenshot, keystroke, clipboard, or credential is collected." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontColor=#52607A;" vertex="1" parent="1"><mxGeometry x="42" y="62" width="1650" height="24" as="geometry"/></mxCell>

        <mxCell id="startLane" value="1. Startup, release, and paired-device continuity" style="swimlane;html=1;horizontal=1;startSize=34;rounded=1;fillColor=#F4F7FB;swimlaneFillColor=#0B1635;strokeColor=#CCD5E2;fontColor=#FFFFFF;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="1740" height="180" as="geometry"/></mxCell>
        <mxCell id="installer" value="0.5.9 NSIS installer&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Same Windows appId; per-user install&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#24365A;fontColor=#0B1635;fontStyle=1;fontSize=15;" vertex="1" parent="startLane"><mxGeometry x="30" y="62" width="220" height="78" as="geometry"/></mxCell>
        <mxCell id="config" value="Existing local config?&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;deviceId + DPAPI-protected credential&lt;/font&gt;" style="rhombus;html=1;whiteSpace=wrap;fillColor=#FFF4D9;strokeColor=#F3A61B;fontColor=#563500;fontStyle=1;fontSize=14;" vertex="1" parent="startLane"><mxGeometry x="310" y="55" width="150" height="92" as="geometry"/></mxCell>
        <mxCell id="existing" value="Existing paired device&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;0.5.9 overlays 0.5.8&lt;br&gt;No pairing required&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#DBF5EC;strokeColor=#14A87C;fontColor=#073A2C;fontStyle=1;fontSize=15;" vertex="1" parent="startLane"><mxGeometry x="530" y="35" width="240" height="94" as="geometry"/></mxCell>
        <mxCell id="newPair" value="New / cleared local data&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;One-time pairing code -&gt; Device API&lt;br&gt;Credential stored only with DPAPI&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFF8EA;strokeColor=#F3A61B;fontColor=#563500;fontStyle=1;fontSize=15;" vertex="1" parent="startLane"><mxGeometry x="530" y="137" width="240" height="74" as="geometry"/></mxCell>
        <mxCell id="runtime" value="DesktopAgentRuntime starts&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Restores queue, status queue, and tracking checkpoint&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#EAF2FB;strokeColor=#2463A8;fontColor=#0A315B;fontStyle=1;fontSize=15;" vertex="1" parent="startLane"><mxGeometry x="850" y="62" width="310" height="78" as="geometry"/></mxCell>
        <mxCell id="session" value="POST /device-client/session/start&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Existing device and credential remain tenant/user/device scoped&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#EDF8F5;strokeColor=#14A87C;fontColor=#073A2C;fontStyle=1;fontSize=14;" vertex="1" parent="startLane"><mxGeometry x="1240" y="62" width="390" height="78" as="geometry"/></mxCell>

        <mxCell id="trackLane" value="2. Windows sampling and 0.5.9 activity-state engine" style="swimlane;html=1;horizontal=1;startSize=34;rounded=1;fillColor=#F8FAFD;swimlaneFillColor=#123B5D;strokeColor=#CCD5E2;fontColor=#FFFFFF;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="1740" height="340" as="geometry"/></mxCell>
        <mxCell id="adapter" value="WindowsForegroundAdapter&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Foreground sample: 100ms&lt;br&gt;Visible-window app scan: 1s&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#EAF2FB;strokeColor=#2463A8;fontColor=#0A315B;fontStyle=1;fontSize=15;" vertex="1" parent="trackLane"><mxGeometry x="30" y="86" width="245" height="98" as="geometry"/></mxCell>
        <mxCell id="sample" value="ForegroundSample&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Normalized foreground app, visible app names, idle/locked state, last input timestamp&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#2463A8;fontColor=#0A315B;fontStyle=1;fontSize=14;" vertex="1" parent="trackLane"><mxGeometry x="330" y="86" width="315" height="98" as="geometry"/></mxCell>
        <mxCell id="state" value="AppTrackingState&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Focus segment per app; 30s input grace; idle/lock/no-window boundaries; max 15s sample-gap protection; UTC day split&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#E8F7F2;strokeColor=#14A87C;fontColor=#073A2C;fontStyle=1;fontSize=15;" vertex="1" parent="trackLane"><mxGeometry x="700" y="76" width="380" height="118" as="geometry"/></mxCell>
        <mxCell id="focusSlice" value="NEW in 0.5.9: durable Focus slice&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;While activity is proven, close one focus-active event every 10s and continue the segment&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#DBF5EC;strokeColor=#14A87C;fontColor=#073A2C;fontStyle=1;fontSize=15;" vertex="1" parent="trackLane"><mxGeometry x="1140" y="76" width="335" height="118" as="geometry"/></mxCell>
        <mxCell id="runtimeEvent" value="Existing Open/runtime slices&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Visible app windows persist in separate 10s runtime events; open is not reported as focused work&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFF8EA;strokeColor=#F3A61B;fontColor=#563500;fontStyle=1;fontSize=14;" vertex="1" parent="trackLane"><mxGeometry x="1530" y="76" width="180" height="118" as="geometry"/></mxCell>
        <mxCell id="boundary" value="Switch App | idle | lock | no valid window | UTC day | graceful shutdown: complete the bounded segment. Duplicate/out-of-order samples never create duration." style="rounded=1;html=1;whiteSpace=wrap;fillColor=#F3F7F5;strokeColor=#B9D2C8;fontColor=#275040;fontSize=14;" vertex="1" parent="trackLane"><mxGeometry x="330" y="228" width="1145" height="42" as="geometry"/></mxCell>

        <mxCell id="syncLane" value="3. Durable upload, report aggregation, and live replacement" style="swimlane;html=1;horizontal=1;startSize=34;rounded=1;fillColor=#F7F9FC;swimlaneFillColor=#0B1635;strokeColor=#CCD5E2;fontColor=#FFFFFF;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="690" width="1740" height="290" as="geometry"/></mxCell>
        <mxCell id="queue" value="FileEventQueue&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Local durable queue; atomic writes; bounded size and retention&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#F5F0FC;strokeColor=#7357B8;fontColor=#382166;fontStyle=1;fontSize=15;" vertex="1" parent="syncLane"><mxGeometry x="30" y="84" width="245" height="94" as="geometry"/></mxCell>
        <mxCell id="heartbeat" value="Heartbeat and status queue&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Current App is live-only; heartbeat normally every 10s&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#EAF2FB;strokeColor=#2463A8;fontColor=#0A315B;fontStyle=1;fontSize=15;" vertex="1" parent="syncLane"><mxGeometry x="330" y="84" width="275" height="94" as="geometry"/></mxCell>
        <mxCell id="upload" value="Device API upload&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Batch app-usage (max 50), heartbeat, and status events&lt;br&gt;clientEventId + sequence provide idempotency&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#EDF8F5;strokeColor=#14A87C;fontColor=#073A2C;fontStyle=1;fontSize=14;" vertex="1" parent="syncLane"><mxGeometry x="660" y="84" width="300" height="94" as="geometry"/></mxCell>
        <mxCell id="server" value="Backend storage&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;ActivityEvent (raw) + AppUsageSummary (focus/idle aggregate)&lt;br&gt;Reports retain both App focus totals and Open/runtime detail&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#0B1635;fontColor=#0B1635;fontStyle=1;fontSize=14;" vertex="1" parent="syncLane"><mxGeometry x="1015" y="84" width="320" height="94" as="geometry"/></mxCell>
        <mxCell id="reports" value="Reports UI&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Heartbeat provides immediate current App; revision check every 5s replaces it with durable summary rows&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFF8EA;strokeColor=#F3A61B;fontColor=#563500;fontStyle=1;fontSize=14;" vertex="1" parent="syncLane"><mxGeometry x="1390" y="84" width="310" height="94" as="geometry"/></mxCell>
        <mxCell id="retry" value="Network/5xx: retry from durable queue with bounded exponential backoff. 401/403: stop retries and require a valid device credential. Acknowledged events are removed only after 2xx." style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFF4F2;strokeColor=#D24A43;fontColor=#7D1713;fontSize=14;" vertex="1" parent="syncLane"><mxGeometry x="330" y="215" width="1005" height="42" as="geometry"/></mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#24365A;" edge="1" parent="1" source="installer" target="config"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="yes" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#14A87C;fontColor=#073A2C;" edge="1" parent="1" source="config" target="existing"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="no" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#F3A61B;fontColor=#563500;" edge="1" parent="1" source="config" target="newPair"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#14A87C;" edge="1" parent="1" source="existing" target="runtime"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#F3A61B;" edge="1" parent="1" source="newPair" target="runtime"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#2463A8;" edge="1" parent="1" source="runtime" target="session"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#2463A8;" edge="1" parent="1" source="adapter" target="sample"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#14A87C;" edge="1" parent="1" source="sample" target="state"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#14A87C;" edge="1" parent="1" source="state" target="focusSlice"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#F3A61B;" edge="1" parent="1" source="focusSlice" target="runtimeEvent"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#7357B8;dashed=1;" edge="1" parent="1" source="focusSlice" target="queue"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1305" y="680"/><mxPoint x="190" y="680"/></Array></mxGeometry></mxCell>
        <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#2463A8;" edge="1" parent="1" source="queue" target="heartbeat"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e13" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#14A87C;" edge="1" parent="1" source="heartbeat" target="upload"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e14" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#0B1635;" edge="1" parent="1" source="upload" target="server"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e15" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#F3A61B;" edge="1" parent="1" source="server" target="reports"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="desktop-agent-focus-059" name="0.5.9 Focus Persistence Lifecycle">
    <mxGraphModel dx="1800" dy="1080" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title2" value="WorkMap Desktop Agent 0.5.9 | Why an App remains visible in Reports" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontStyle=1;fontSize=28;fontColor=#0B1635;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1500" height="42" as="geometry"/></mxCell>
        <mxCell id="subtitle2" value="0.5.8 could leave a long uninterrupted App only in live heartbeat. 0.5.9 emits durable focus slices during continued proven use, so the selected-day Apps list keeps prior and current Apps." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontColor=#52607A;" vertex="1" parent="1"><mxGeometry x="42" y="62" width="1680" height="24" as="geometry"/></mxCell>

        <mxCell id="lane1" value="Continuous Focus Active lifecycle" style="swimlane;html=1;horizontal=1;startSize=34;rounded=1;fillColor=#F8FAFD;swimlaneFillColor=#123B5D;strokeColor=#CCD5E2;fontColor=#FFFFFF;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="1740" height="270" as="geometry"/></mxCell>
        <mxCell id="input" value="Foreground App receives valid user input&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Input time is supplied by Windows GetLastInputInfo&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#EAF2FB;strokeColor=#2463A8;fontColor=#0A315B;fontStyle=1;fontSize=15;" vertex="1" parent="lane1"><mxGeometry x="30" y="87" width="250" height="84" as="geometry"/></mxCell>
        <mxCell id="focus" value="Focus segment opens / refreshes&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;App is Focus Active for only the evidenced input interval plus max 30s grace&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#E8F7F2;strokeColor=#14A87C;fontColor=#073A2C;fontStyle=1;fontSize=15;" vertex="1" parent="lane1"><mxGeometry x="340" y="87" width="315" height="84" as="geometry"/></mxCell>
        <mxCell id="clock" value="10 seconds of continuously proven activity?" style="rhombus;html=1;whiteSpace=wrap;fillColor=#FFF4D9;strokeColor=#F3A61B;fontColor=#563500;fontStyle=1;fontSize=14;" vertex="1" parent="lane1"><mxGeometry x="720" y="72" width="150" height="110" as="geometry"/></mxCell>
        <mxCell id="event" value="Persist Focus Active slice&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;One bounded AppUsageEvent; continue a fresh segment from the same boundary&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#DBF5EC;strokeColor=#14A87C;fontColor=#073A2C;fontStyle=1;fontSize=15;" vertex="1" parent="lane1"><mxGeometry x="940" y="87" width="315" height="84" as="geometry"/></mxCell>
        <mxCell id="summary" value="Server accepts idempotently&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;ActivityEvent + AppUsageSummary updated; total grows without waiting for App switch&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#0B1635;fontColor=#0B1635;fontStyle=1;fontSize=15;" vertex="1" parent="lane1"><mxGeometry x="1325" y="87" width="340" height="84" as="geometry"/></mxCell>

        <mxCell id="lane2" value="Reports interpretation and boundaries" style="swimlane;html=1;horizontal=1;startSize=34;rounded=1;fillColor=#F7F9FC;swimlaneFillColor=#0B1635;strokeColor=#CCD5E2;fontColor=#FFFFFF;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="1740" height="270" as="geometry"/></mxCell>
        <mxCell id="live" value="Immediate live view&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Heartbeat sends current foreground App for connection/current-focus UI&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#EAF2FB;strokeColor=#2463A8;fontColor=#0A315B;fontStyle=1;fontSize=15;" vertex="1" parent="lane2"><mxGeometry x="30" y="87" width="275" height="84" as="geometry"/></mxCell>
        <mxCell id="revision" value="Reports revision check: every 5 seconds&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Detects the persisted slice and refreshes only when revision changed&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFF8EA;strokeColor=#F3A61B;fontColor=#563500;fontStyle=1;fontSize=15;" vertex="1" parent="lane2"><mxGeometry x="365" y="87" width="315" height="84" as="geometry"/></mxCell>
        <mxCell id="apps" value="Apps list for the selected date range&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Keeps every persisted Focus App; sorted by Focus Active, then Open/runtime&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#DBF5EC;strokeColor=#14A87C;fontColor=#073A2C;fontStyle=1;fontSize=15;" vertex="1" parent="lane2"><mxGeometry x="740" y="87" width="310" height="84" as="geometry"/></mxCell>
        <mxCell id="open" value="Open/runtime detail stays separate&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;A visible App window can be recorded without claiming user interaction&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#F5F0FC;strokeColor=#7357B8;fontColor=#382166;fontStyle=1;fontSize=15;" vertex="1" parent="lane2"><mxGeometry x="1110" y="87" width="300" height="84" as="geometry"/></mxCell>
        <mxCell id="privacy" value="Privacy boundary&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;App name + duration only. No title, URL path/query, content, screenshots, keyboard, clipboard, camera, or microphone.&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFF4F2;strokeColor=#D24A43;fontColor=#7D1713;fontStyle=1;fontSize=14;" vertex="1" parent="lane2"><mxGeometry x="1470" y="70" width="230" height="118" as="geometry"/></mxCell>

        <mxCell id="lane3" value="Boundaries that end a focus slice" style="swimlane;html=1;horizontal=1;startSize=34;rounded=1;fillColor=#F4F7FB;swimlaneFillColor=#123B5D;strokeColor=#CCD5E2;fontColor=#FFFFFF;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="730" width="1740" height="190" as="geometry"/></mxCell>
        <mxCell id="switch" value="App switch&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Previous App closes at its valid boundary&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#2463A8;fontColor=#0A315B;fontStyle=1;fontSize=15;" vertex="1" parent="lane3"><mxGeometry x="35" y="65" width="235" height="72" as="geometry"/></mxCell>
        <mxCell id="idle" value="Idle / locked / no valid window&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Focus stops; idle is separate where applicable&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#2463A8;fontColor=#0A315B;fontStyle=1;fontSize=15;" vertex="1" parent="lane3"><mxGeometry x="330" y="65" width="290" height="72" as="geometry"/></mxCell>
        <mxCell id="gap" value="Delayed or duplicate sample&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Maximum sample gap prevents invented duration&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#2463A8;fontColor=#0A315B;fontStyle=1;fontSize=15;" vertex="1" parent="lane3"><mxGeometry x="680" y="65" width="280" height="72" as="geometry"/></mxCell>
        <mxCell id="shutdown" value="UTC day boundary or graceful shutdown&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Flush completed slice to the same durable queue&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#2463A8;fontColor=#0A315B;fontStyle=1;fontSize=15;" vertex="1" parent="lane3"><mxGeometry x="1020" y="65" width="325" height="72" as="geometry"/></mxCell>
        <mxCell id="recover" value="Unexpected exit&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Next start uses the local tracking checkpoint and queue recovery path&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#F5F0FC;strokeColor=#7357B8;fontColor=#382166;fontStyle=1;fontSize=15;" vertex="1" parent="lane3"><mxGeometry x="1405" y="65" width="295" height="72" as="geometry"/></mxCell>

        <mxCell id="f1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#2463A8;" edge="1" parent="1" source="input" target="focus"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#14A87C;" edge="1" parent="1" source="focus" target="clock"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f3" value="yes" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#14A87C;fontColor=#073A2C;" edge="1" parent="1" source="clock" target="event"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#0B1635;" edge="1" parent="1" source="event" target="summary"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f5" value="continue" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#14A87C;dashed=1;fontColor=#073A2C;" edge="1" parent="1" source="event" target="focus"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1090" y="360"/><mxPoint x="500" y="360"/></Array></mxGeometry></mxCell>
        <mxCell id="f6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#F3A61B;dashed=1;" edge="1" parent="1" source="summary" target="revision"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1500" y="400"/><mxPoint x="525" y="400"/></Array></mxGeometry></mxCell>
