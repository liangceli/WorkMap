<mxfile host="app.diagrams.net" modified="2026-07-16T10:30:00.000Z" agent="Codex" version="26.0.11" type="device">
  <diagram id="desktop-agent-runtime-0510" name="0.5.10 Linear Runtime Flow">
    <mxGraphModel dx="1900" dy="1080" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="WorkMap Desktop Agent 0.5.10 | End-to-end linear reporting flow" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontStyle=1;fontSize=28;fontColor=#0B1635;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1700" height="42" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Privacy-minimized foreground-app timing. Only normalized app name, time boundaries, device/session metadata, and status are used. No window title, content, screenshot, keystroke, clipboard, or credential enters activity payloads." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontColor=#52607A;" vertex="1" parent="1"><mxGeometry x="42" y="64" width="1770" height="24" as="geometry"/></mxCell>

        <mxCell id="startupLane" value="1. Installation and startup" style="swimlane;html=1;horizontal=1;startSize=32;rounded=1;fillColor=#F4F7FB;swimlaneFillColor=#0B1635;strokeColor=#CCD5E2;fontColor=#FFFFFF;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="1800" height="138" as="geometry"/></mxCell>
        <mxCell id="installer" value="Install 0.5.10&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Windows NSIS installer, same app identity&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#24365A;fontColor=#0B1635;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="70" y="165" width="210" height="68" as="geometry"/></mxCell>
        <mxCell id="config" value="Load existing local config&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;deviceId + DPAPI-protected device credential&lt;br&gt;No re-pair if that config remains&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#EAF2FB;strokeColor=#2463A8;fontColor=#0A315B;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="345" y="155" width="260" height="86" as="geometry"/></mxCell>
        <mxCell id="restore" value="Restore local durability&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Load FileEventQueue + status queue&lt;br&gt;Recover the saved tracking checkpoint&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#F5F0FC;strokeColor=#7357B8;fontColor=#382166;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="670" y="155" width="260" height="86" as="geometry"/></mxCell>
        <mxCell id="session" value="Start or recover Agent session&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;POST /device-client/session/start&lt;br&gt;sessionId + monotonic sequence number&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#EDF8F5;strokeColor=#14A87C;fontColor=#073A2C;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1000" y="155" width="285" height="86" as="geometry"/></mxCell>
        <mxCell id="initialHeartbeat" value="Initial heartbeat&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Reports device/session is connected before the first activity slice&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFF8EA;strokeColor=#F3A61B;fontColor=#563500;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1350" y="155" width="250" height="86" as="geometry"/></mxCell>
        <mxCell id="localStatus" value="Local Agent UI status&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Connected / retrying / auth required&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#52607A;fontColor=#0B1635;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1650" y="165" width="155" height="68" as="geometry"/></mxCell>

        <mxCell id="samplingLane" value="2. Every foreground sample (default every 100ms)" style="swimlane;html=1;horizontal=1;startSize=32;rounded=1;fillColor=#F7F9FC;swimlaneFillColor=#123B5D;strokeColor=#CCD5E2;fontColor=#FFFFFF;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="275" width="1800" height="212" as="geometry"/></mxCell>
        <mxCell id="windows" value="Windows foreground adapter&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;User32 foreground window + process name&lt;br&gt;last input, idle/locked, visible open apps&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#EAF2FB;strokeColor=#2463A8;fontColor=#0A315B;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="70" y="326" width="285" height="98" as="geometry"/></mxCell>
        <mxCell id="minimize" value="Privacy filter&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Normalize app name. Discard title, document, page, and content details.&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFF4D9;strokeColor=#F3A61B;fontColor=#563500;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="420" y="326" width="220" height="98" as="geometry"/></mxCell>
        <mxCell id="tracking" value="AppTrackingState&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Starts/continues a Focus Active segment after fresh input; keeps recent cross-app work within the 30s grace period; tracks Open/runtime separately.&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#DBF5EC;strokeColor=#14A87C;fontColor=#073A2C;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="705" y="316" width="365" height="116" as="geometry"/></mxCell>
        <mxCell id="boundary" value="Completion boundary?&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;10s slice, app change, input grace expiry, idle, lock, no window, UTC day, or shutdown&lt;/font&gt;" style="rhombus;html=1;whiteSpace=wrap;fillColor=#FFF4D9;strokeColor=#F3A61B;fontColor=#563500;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1140" y="313" width="180" height="122" as="geometry"/></mxCell>
        <mxCell id="activityEvent" value="Completed AppUsageEvent&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;appName, startedAt, endedAt, durationSeconds, clientEventId, sequence; never 0/negative duration&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#EDF8F5;strokeColor=#14A87C;fontColor=#073A2C;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1395" y="316" width="350" height="116" as="geometry"/></mxCell>

        <mxCell id="syncLane" value="3. 0.5.10 durability and API order" style="swimlane;html=1;horizontal=1;startSize=32;rounded=1;fillColor=#F4F7FB;swimlaneFillColor=#0B1635;strokeColor=#CCD5E2;fontColor=#FFFFFF;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="515" width="1800" height="246" as="geometry"/></mxCell>
        <mxCell id="queue" value="A. Persist locally first&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;FileEventQueue atomically stores each completed slice. Bounded queue and retry metadata survive Agent restart.&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#F5F0FC;strokeColor=#7357B8;fontColor=#382166;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="70" y="572" width="300" height="104" as="geometry"/></mxCell>
        <mxCell id="flush" value="B. NEW: upload before rollover heartbeat&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Flush queued /app-usage event(s), max 50. 2xx acknowledgement removes only those stable clientEventIds.&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#DBF5EC;strokeColor=#14A87C;fontColor=#073A2C;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="440" y="572" width="335" height="104" as="geometry"/></mxCell>
        <mxCell id="backend" value="C. Backend persists once&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Idempotency accepts retries once and updates ActivityEvent + AppUsageSummary + activity revision.&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#24365A;fontColor=#0B1635;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="845" y="572" width="310" height="104" as="geometry"/></mxCell>
        <mxCell id="nextHeartbeat" value="D. Then send heartbeat&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Current App reports the fresh post-rollover segment. It can begin at 0s because the previous slice is already durable.&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#EAF2FB;strokeColor=#2463A8;fontColor=#0A315B;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1225" y="572" width="330" height="104" as="geometry"/></mxCell>
        <mxCell id="statusQueue" value="Parallel status path&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Heartbeat / lifecycle status queue reports running, reconnect, stopped, or interruption separately from activity duration.&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFF8EA;strokeColor=#F3A61B;fontColor=#563500;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1625" y="572" width="180" height="104" as="geometry"/></mxCell>
        <mxCell id="retry" value="If network or server fails: the completed activity remains in FileEventQueue and retries with bounded backoff. It is not replaced by a zero heartbeat value. 401/403 stops retries and requires valid device authorization." style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFF4F2;strokeColor=#D24A43;fontColor=#7D1713;fontSize=14;" vertex="1" parent="1"><mxGeometry x="255" y="700" width="1300" height="36" as="geometry"/></mxCell>

        <mxCell id="reportsLane" value="4. Owner / Employee Reports display" style="swimlane;html=1;horizontal=1;startSize=32;rounded=1;fillColor=#F7F9FC;swimlaneFillColor=#123B5D;strokeColor=#CCD5E2;fontColor=#FFFFFF;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="790" width="1800" height="210" as="geometry"/></mxCell>
        <mxCell id="summaryApi" value="Usage summary API&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Returns durable aggregates for the selected scope and UTC date range.&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#24365A;fontColor=#0B1635;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="70" y="846" width="260" height="84" as="geometry"/></mxCell>
        <mxCell id="liveApi" value="Live status API&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Returns current heartbeat / current App and activity revision. Reports polls while visible every 5s.&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#EAF2FB;strokeColor=#2463A8;fontColor=#0A315B;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="400" y="846" width="300" height="84" as="geometry"/></mxCell>
        <mxCell id="merge" value="Merge durable total + current live tail&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Example: persisted Edge 6m 10s + fresh current segment 7s = 6m 17s.&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#DBF5EC;strokeColor=#14A87C;fontColor=#073A2C;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="770" y="846" width="310" height="84" as="geometry"/></mxCell>
        <mxCell id="guard" value="0.5.10 same-view display guard&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Until aggregate refresh catches up, keep the last displayed maximum for exactly the same user/company, department, range, and timezone.&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFF4D9;strokeColor=#F3A61B;fontColor=#563500;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1150" y="836" width="355" height="104" as="geometry"/></mxCell>
        <mxCell id="ui" value="Reports UI&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Focus Active does not visually fall at a normal 10s rollover. New report filters deliberately reset the guard.&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#24365A;fontColor=#0B1635;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1575" y="846" width="230" height="84" as="geometry"/></mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#0B1635;" edge="1" parent="1" source="installer" target="config"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#0B1635;" edge="1" parent="1" source="config" target="restore"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#0B1635;" edge="1" parent="1" source="restore" target="session"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#0B1635;" edge="1" parent="1" source="session" target="initialHeartbeat"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#0B1635;" edge="1" parent="1" source="initialHeartbeat" target="localStatus"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#2463A8;" edge="1" parent="1" source="windows" target="minimize"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#14A87C;" edge="1" parent="1" source="minimize" target="tracking"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#F3A61B;" edge="1" parent="1" source="tracking" target="boundary"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#14A87C;" edge="1" parent="1" source="boundary" target="activityEvent"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#7357B8;" edge="1" parent="1" source="activityEvent" target="queue"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1570" y="500"/><mxPoint x="220" y="500"/></Array></mxGeometry></mxCell>
        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#14A87C;" edge="1" parent="1" source="queue" target="flush"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#14A87C;" edge="1" parent="1" source="flush" target="backend"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e13" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#2463A8;" edge="1" parent="1" source="backend" target="nextHeartbeat"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e14" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#F3A61B;" edge="1" parent="1" source="nextHeartbeat" target="statusQueue"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e15" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#0B1635;" edge="1" parent="1" source="backend" target="summaryApi"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1000" y="775"/><mxPoint x="200" y="775"/></Array></mxGeometry></mxCell>
        <mxCell id="e16" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#2463A8;" edge="1" parent="1" source="nextHeartbeat" target="liveApi"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1390" y="775"/><mxPoint x="550" y="775"/></Array></mxGeometry></mxCell>
        <mxCell id="e17" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#14A87C;" edge="1" parent="1" source="summaryApi" target="merge"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e18" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#14A87C;" edge="1" parent="1" source="liveApi" target="merge"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="700" y="888"/><mxPoint x="740" y="888"/></Array></mxGeometry></mxCell>
        <mxCell id="e19" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#F3A61B;" edge="1" parent="1" source="merge" target="guard"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e20" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#0B1635;" edge="1" parent="1" source="guard" target="ui"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="desktop-agent-example-0510" name="0.5.10 Edge rollover example">
    <mxGraphModel dx="1900" dy="1080" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title2" value="WorkMap Desktop Agent 0.5.10 | Why Focus Active no longer falls at a 10-second boundary" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontStyle=1;fontSize=28;fontColor=#0B1635;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1740" height="42" as="geometry"/></mxCell>
        <mxCell id="subtitle2" value="Worked example: the employee keeps using Microsoft Edge. A completed 10-second slice becomes durable before Reports is told about the new live slice. The same event cannot be counted twice because its clientEventId is idempotent." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontColor=#52607A;" vertex="1" parent="1"><mxGeometry x="42" y="64" width="1760" height="24" as="geometry"/></mxCell>

        <mxCell id="timeLane" value="Normal online sequence" style="swimlane;html=1;horizontal=1;startSize=34;rounded=1;fillColor=#F4F7FB;swimlaneFillColor=#0B1635;strokeColor=#CCD5E2;fontColor=#FFFFFF;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="1800" height="300" as="geometry"/></mxCell>
        <mxCell id="t1" value="1. At 10:06:00&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Persisted Edge total = 6m 00s&lt;br&gt;Live Focus segment = 17s&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#24365A;fontColor=#0B1635;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="75" y="190" width="245" height="100" as="geometry"/></mxCell>
        <mxCell id="t2" value="2. Reports shows 6m 17s&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Durable summary 6m 00s + current live tail 17s&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#DBF5EC;strokeColor=#14A87C;fontColor=#073A2C;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="395" y="190" width="255" height="100" as="geometry"/></mxCell>
        <mxCell id="t3" value="3. At next 10s boundary&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;TrackingState closes 10s of proven Edge focus and immediately starts a new Edge segment at 0s.&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFF4D9;strokeColor=#F3A61B;fontColor=#563500;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="725" y="180" width="300" height="120" as="geometry"/></mxCell>
        <mxCell id="t4" value="4. 0.5.10 queue and upload&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Completed 10s slice is atomically queued, POSTed, and acknowledged before the next heartbeat runs.&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#F5F0FC;strokeColor=#7357B8;fontColor=#382166;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1100" y="180" width="300" height="120" as="geometry"/></mxCell>
        <mxCell id="t5" value="5. New heartbeat can say 0s&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;It describes only the fresh segment. Backend aggregate already contains the completed 10s slice.&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#EAF2FB;strokeColor=#2463A8;fontColor=#0A315B;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1475" y="180" width="300" height="120" as="geometry"/></mxCell>
        <mxCell id="t6" value="Result: Reports reads the new durable total plus the new live tail. If the two responses cross in flight, the same-view guard preserves the last visible 6m 17s until the aggregate response arrives. It never displays 6m 00s + 0s as a fall." style="rounded=1;html=1;whiteSpace=wrap;fillColor=#EDF8F5;strokeColor=#14A87C;fontColor=#073A2C;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="235" y="335" width="1370" height="48" as="geometry"/></mxCell>

        <mxCell id="offlineLane" value="If the network is unavailable" style="swimlane;html=1;horizontal=1;startSize=34;rounded=1;fillColor=#F7F9FC;swimlaneFillColor=#7D1713;strokeColor=#D24A43;fontColor=#FFFFFF;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="460" width="1800" height="180" as="geometry"/></mxCell>
        <mxCell id="o1" value="Completed Edge slice stays in FileEventQueue&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;It survives Agent restart. The local checkpoint protects the continuing live segment.&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFF4F2;strokeColor=#D24A43;fontColor=#7D1713;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="100" y="520" width="370" height="76" as="geometry"/></mxCell>
        <mxCell id="o2" value="Heartbeat failure is status only&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Reports may show stale / interrupted state, but the completed duration has not been discarded or replaced by a zero event.&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFF8EA;strokeColor=#F3A61B;fontColor=#563500;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="600" y="520" width="380" height="76" as="geometry"/></mxCell>
        <mxCell id="o3" value="Network returns&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Retry sends the original clientEventId. Backend acknowledges it once, updates the aggregate, and the queue removes it after success.&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#DBF5EC;strokeColor=#14A87C;fontColor=#073A2C;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1110" y="520" width="410" height="76" as="geometry"/></mxCell>

        <mxCell id="boundaryLane" value="Other completion boundaries and their effect" style="swimlane;html=1;horizontal=1;startSize=34;rounded=1;fillColor=#F4F7FB;swimlaneFillColor=#123B5D;strokeColor=#CCD5E2;fontColor=#FFFFFF;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="680" width="1800" height="250" as="geometry"/></mxCell>
        <mxCell id="b1" value="App switch&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Close the prior focus segment at the input boundary; begin the new app segment.&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#24365A;fontColor=#0B1635;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="75" y="750" width="250" height="82" as="geometry"/></mxCell>
        <mxCell id="b2" value="Idle or lock&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Close Focus Active at the exact idle / lock boundary. Idle time is distinct from active time.&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#24365A;fontColor=#0B1635;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="405" y="750" width="270" height="82" as="geometry"/></mxCell>
        <mxCell id="b3" value="No valid foreground window&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Finish focus; do not invent active seconds. Open/runtime remains a separate measure.&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#24365A;fontColor=#0B1635;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="755" y="750" width="290" height="82" as="geometry"/></mxCell>
        <mxCell id="b4" value="UTC day or graceful shutdown&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Flush final bounded slice, status event, then close the Agent session where reachable.&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#24365A;fontColor=#0B1635;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1125" y="750" width="295" height="82" as="geometry"/></mxCell>
        <mxCell id="b5" value="Abrupt crash / power loss&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Last saved checkpoint is recovered at next Agent start. Only the in-memory fraction after the latest checkpoint is the bounded residual risk.&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFF4F2;strokeColor=#D24A43;fontColor=#7D1713;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1500" y="740" width="285" height="102" as="geometry"/></mxCell>

        <mxCell id="f1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#0B1635;" edge="1" parent="1" source="t1" target="t2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#F3A61B;" edge="1" parent="1" source="t2" target="t3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#7357B8;" edge="1" parent="1" source="t3" target="t4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#2463A8;" edge="1" parent="1" source="t4" target="t5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#14A87C;" edge="1" parent="1" source="t5" target="t6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1630" y="325"/><mxPoint x="1500" y="325"/></Array></mxGeometry></mxCell>
        <mxCell id="f6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#D24A43;" edge="1" parent="1" source="o1" target="o2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f7" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#14A87C;" edge="1" parent="1" source="o2" target="o3"><mxGeometry relative="1" as="geometry"/></mxCell>
